<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista 1 Exercício 1</title>
</head>
<body>
    
   <h1>Classificação de Nadadores</h1>
   
   <form action="/classificar" method="post">
    <label for="idade">Digite sua idade:</label> <br>
    <input type="text" name="idade" value="<%= valores.idade %>"> <br>
    <button type="submit">Classificar</button>
   </form>

   <% 
        if(retorno){
            // temos retorno
        %>
            <h2>Categoria: <%= retorno.categoria %></h2>
        <%    
        }else{
            //sem retorno
        %>    
            <h2>Não temos retorno</h2>
        <%
        }
   
   
   %>

</body>
</html>